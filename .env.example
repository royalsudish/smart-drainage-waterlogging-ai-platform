# ==============================================================================
# Smart India-Wide Multi-Risk AI Platform — Environment Variables Example
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# ==============================================================================

# Application identity
APP_USER_AGENT=SmartMultiRiskPlatform/1.0
APP_CONTACT_EMAIL=your-email@example.com
REQUEST_TIMEOUT_SECONDS=20

# Open-Meteo & Environmental Data Endpoints
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_METEO_SPATIAL_URL=https://api.open-meteo.com/v1/forecast

# Geospatial & Satellite Sources
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
BHUVAN_WMS_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms
MOSDAC_MDAPI_ZIP=https://www.mosdac.gov.in/software/mdapi.zip

# NASA FIRMS Active Fire API (optional for fire risk overlay)
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Local SQLite Storage Paths
ALERT_DB_PATH=data/alerts.db

# Alert Notification Settings (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=alerts@example.com
FCM_SERVER_KEY=your_fcm_server_key_here
